import:
    org.bukkit.event.player.PlayerFishEvent
    org.bukkit.event.player.PlayerFishEvent$State
    org.bukkit.entity.FishHook

# ============================================================
# FISHING BARREL SYSTEM
# ============================================================
#
# One shared composter location; each player has their own fish
# stored inside it, visible only to themselves.
#
# Commands:
#   /fishbarrel set                  (op) — aim at composter to register
#   /fishbarrel level <player> <1-5> (op) — set a player's barrel level
#   /fishbarrel clear <player>       (op) — empty a player's barrel
#
# Per-player variables (keyed by UUID):
#   {-fishbarrel::level::%uuid%}              — barrel level 1-5 (default 1)
#   {-fishbarrel::count::%uuid%}              — fish currently stored
#   {-fishbarrel::slot::%uuid%::%n%::id}      — fake entity ID for slot n
#   {-fishbarrel::slot::%uuid%::%n%::fish}    — item stored in slot n
#   {-fishbarrel::composter::id::%uuid%}      — fake entity ID for barrel display
#
# Shared variable:
#   {-fishbarrel::loc}                        — the composter block location
#
# Capacity by level:
#   Level 1 — x1.0 scale — 50  fish
#   Level 2 — x1.2 scale — 75  fish
#   Level 3 — x1.4 scale — 100 fish
#   Level 4 — x1.6 scale — 125 fish
#   Level 5 — x1.8 scale — 150 fish
#
# ============================================================


# ============================================================
# LEVEL HELPERS
# ============================================================

function fishbarrel_maxFish(p: player) :: integer:
    set {_level} to ({-fishbarrel::level::%uuid of {_p}%} ? 1)
    return {_level} * 25 + 25

function fishbarrel_levelScale(p: player) :: number:
    set {_level} to ({-fishbarrel::level::%uuid of {_p}%} ? 1)
    return ({_level} - 1) * 0.2 + 1.0


# ============================================================
# SLOT POSITION HELPER
# ============================================================
# Takes an explicit scale so callers can pass the player's level
# scale without needing to thread the player into every call.
#
# Rings of 10 items stack upward. Odd layers are offset 18° for
# a staggered brick-like pattern. Radius and height scale with
# the barrel level so fish fill the bigger visual barrel.

function fishbarrel_slotPos(slot: integer, scale: number) :: location:
    if {-fishbarrel::loc} is not set:
        stop
    set {_bx} to floor(x-coord of {-fishbarrel::loc}) + 0.5
    set {_by} to floor(y-coord of {-fishbarrel::loc})
    set {_bz} to floor(z-coord of {-fishbarrel::loc}) + 0.5
    set {_w} to world of {-fishbarrel::loc}

    set {_n} to {_slot} - 1
    set {_layer} to floor({_n} / 10)
    set {_pos} to {_n} - ({_layer} * 10)

    if {_pos} = 0:
        set {_r} to 0.0
    else:
        set {_r} to 0.25 * {_scale}

    set {_offset} to 0.0
    if mod({_layer}, 2) = 1:
        set {_offset} to 18.0

    set {_angle} to ({_pos} / 10.0) * 360.0 + {_offset}
    set {_x} to {_bx} + {_r} * cos({_angle})
    set {_z} to {_bz} + {_r} * sin({_angle})
    set {_y} to {_by} + 0.3 + ({_layer} * 0.2 * {_scale})

    return location({_x}, {_y}, {_z}, {_w})


# ============================================================
# COMPOSTER DISPLAY (per-player)
# ============================================================

function fishbarrel_spawnComposterFor(p: player):
    if {-fishbarrel::loc} is not set:
        stop
    set {_uuid} to uuid of {_p}
    if {-fishbarrel::composter::id::%{_uuid}%} is not set:
        set {-fishbarrel::composter::id::%{_uuid}%} to random integer between 100000 and 9999999
    set {_id} to {-fishbarrel::composter::id::%{_uuid}%}
    set {_s} to fishbarrel_levelScale({_p})
    set {_bx} to floor(x-coord of {-fishbarrel::loc}) + 0.5
    set {_by} to floor(y-coord of {-fishbarrel::loc})
    set {_bz} to floor(z-coord of {-fishbarrel::loc}) + 0.5
    set {_w} to world of {-fishbarrel::loc}
    set {_loc} to location({_bx}, {_by} + ({_s} / 2.0), {_bz}, {_w})
    spawn fake item display at {_loc} for {_p} with id {_id}
    set {_m} to new metadata packet with id {_id}:
        display item: composter
        display scale: vector({_s}, {_s}, {_s})
        display billboard: fixed
        display brightness block: 15
        display teleportduration: 0
        display transformation: 0
        display interpolation: 0
    send packet {_m} to {_p}


function fishbarrel_updateComposter(p: player):
    set {_uuid} to uuid of {_p}
    if {-fishbarrel::composter::id::%{_uuid}%} is not set:
        stop
    if {-fishbarrel::loc} is not set:
        stop
    set {_id} to {-fishbarrel::composter::id::%{_uuid}%}
    set {_s} to fishbarrel_levelScale({_p})
    set {_bx} to floor(x-coord of {-fishbarrel::loc}) + 0.5
    set {_by} to floor(y-coord of {-fishbarrel::loc})
    set {_bz} to floor(z-coord of {-fishbarrel::loc}) + 0.5
    set {_w} to world of {-fishbarrel::loc}
    set {_loc} to location({_bx}, {_by} + ({_s} / 2.0), {_bz}, {_w})
    send teleport packet with id {_id} with location {_loc} to {_p}
    set {_m} to new metadata packet with id {_id}:
        display scale: vector({_s}, {_s}, {_s})
        display teleportduration: 5
        display transformation: 3
        display interpolation: 5
    send packet {_m} to {_p}


function fishbarrel_removeComposter(p: player):
    set {_uuid} to uuid of {_p}
    if {-fishbarrel::composter::id::%{_uuid}%} is not set:
        stop
    remove fake entity with id {-fishbarrel::composter::id::%{_uuid}%} for {_p}
    delete {-fishbarrel::composter::id::%{_uuid}%}


# ============================================================
# DISPLAY MANAGEMENT (per-player slots)
# ============================================================

function fishbarrel_spawnSlotFor(p: player, slot: integer):
    set {_uuid} to uuid of {_p}
    if {-fishbarrel::slot::%{_uuid}%::%{_slot}%::id} is not set:
        stop
    set {_id} to {-fishbarrel::slot::%{_uuid}%::%{_slot}%::id}
    set {_fish} to {-fishbarrel::slot::%{_uuid}%::%{_slot}%::fish}
    set {_scale} to fishbarrel_levelScale({_p})
    set {_pos} to fishbarrel_slotPos({_slot}, {_scale})
    if {_pos} is not set:
        stop
    spawn fake item display at {_pos} for {_p} with id {_id}
    set {_m} to new metadata packet with id {_id}:
        display item: {_fish}
        display scale: vector(0.28, 0.28, 0.28)
        display billboard: center
        display brightness block: 15
        display teleportduration: 2
        display transformation: 3
        display interpolation: 0
    send packet {_m} to {_p}


function fishbarrel_removeSlot(p: player, slot: integer):
    set {_uuid} to uuid of {_p}
    if {-fishbarrel::slot::%{_uuid}%::%{_slot}%::id} is not set:
        stop
    remove fake entity with id {-fishbarrel::slot::%{_uuid}%::%{_slot}%::id} for {_p}
    delete {-fishbarrel::slot::%{_uuid}%::%{_slot}%::id}
    delete {-fishbarrel::slot::%{_uuid}%::%{_slot}%::fish}


# ============================================================
# REORGANISE FISH ON LEVEL CHANGE
# ============================================================
# Smoothly slides all of a player's existing fish displays to
# their new positions after the barrel level (and thus scale)
# has changed. Safe to call while the barrel is full.

function fishbarrel_reorganize(p: player):
    set {_uuid} to uuid of {_p}
    set {_scale} to fishbarrel_levelScale({_p})
    set {_max} to fishbarrel_maxFish({_p})
    loop {_max} times:
        set {_n} to loop-number
        if {-fishbarrel::slot::%{_uuid}%::%{_n}%::id} is set:
            set {_id} to {-fishbarrel::slot::%{_uuid}%::%{_n}%::id}
            set {_pos} to fishbarrel_slotPos({_n}, {_scale})
            if {_pos} is set:
                send teleport packet with id {_id} with location {_pos} to {_p}
                set {_m} to new metadata packet with id {_id}:
                    display teleportduration: 10
                    display transformation: 3
                    display interpolation: 10
                send packet {_m} to {_p}


# ============================================================
# FLY ANIMATION + PLACE
# ============================================================

function fishbarrel_flyAndPlace(p: player, hookLoc: location, slot: integer, fishItem: item):
    set {_uuid} to uuid of {_p}
    set {_id} to random integer between 100000 and 9999999
    set {-fishbarrel::slot::%{_uuid}%::%{_slot}%::id} to {_id}
    set {-fishbarrel::slot::%{_uuid}%::%{_slot}%::fish} to {_fishItem}

    set {_scale} to fishbarrel_levelScale({_p})
    set {_dest} to fishbarrel_slotPos({_slot}, {_scale})
    if {_dest} is not set:
        stop

    set {_sx} to x-coord of {_hookLoc}
    set {_sy} to y-coord of {_hookLoc}
    set {_sz} to z-coord of {_hookLoc}
    set {_ex} to x-coord of {_dest}
    set {_ey} to y-coord of {_dest}
    set {_ez} to z-coord of {_dest}
    set {_w} to world of {_hookLoc}

    set {_flyId} to random integer between 100000 and 9999999
    spawn fake item display at {_hookLoc} for {_p} with id {_flyId}
    set {_m} to new metadata packet with id {_flyId}:
        display item: {_fishItem}
        display scale: vector(0.01, 0.01, 0.01)
        display billboard: center
        display brightness block: 15
        display teleportduration: 2
        display transformation: 3
        display interpolation: 0
        glowing: true
        display glow: rgb(0, 210, 255)
    send packet {_m} to {_p}

    wait 1 tick

    set {_m} to new metadata packet with id {_flyId}:
        display scale: vector(0.38, 0.38, 0.38)
        display transformation: 4
        display interpolation: 0
    send packet {_m} to {_p}

    play sound "entity.fishing_bobber.splash" with volume 0.5 and pitch 1.3 to {_p}

    loop 20 times:
        set {_t} to loop-number / 20.0
        set {_arcY} to sin({_t} * 180) * 1.4
        set {_nx} to {_sx} + ({_ex} - {_sx}) * {_t}
        set {_ny} to {_sy} + ({_ey} - {_sy}) * {_t} + {_arcY}
        set {_nz} to {_sz} + ({_ez} - {_sz}) * {_t}
        send teleport packet with id {_flyId} with location location({_nx}, {_ny}, {_nz}, {_w}) to {_p}
        wait 1 tick

    set {_m} to new metadata packet with id {_flyId}:
        display scale: vector(0.22, 0.22, 0.22)
        display transformation: 5
        display interpolation: 0
    send packet {_m} to {_p}

    wait 2 ticks

    remove fake entity with id {_flyId} for {_p}
    fishbarrel_spawnSlotFor({_p}, {_slot})

    set {_max} to fishbarrel_maxFish({_p})
    set {_count} to ({-fishbarrel::count::%{_uuid}%} ? 0)
    play sound "entity.item.pickup" with volume 0.7 and pitch 1.3 to {_p}
    send action bar "&b&l✦ Fish stored in barrel! &7(%{_count}%/%{_max}%)" to {_p}


# ============================================================
# PUBLIC ADD ENTRY POINT
# ============================================================

function fishbarrel_addFish(p: player, hookLoc: location):
    if {-fishbarrel::loc} is not set:
        give cod to {_p}
        stop

    set {_uuid} to uuid of {_p}
    set {_count} to ({-fishbarrel::count::%{_uuid}%} ? 0)
    set {_max} to fishbarrel_maxFish({_p})

    if {_count} >= {_max}:
        send action bar "&c&lBarrel is full! &7(%{_max}%/%{_max}%) — Fish added to inventory." to {_p}
        give cod to {_p}
        stop

    set {_slot} to 0
    loop {_max} times:
        if {-fishbarrel::slot::%{_uuid}%::%loop-number%::id} is not set:
            set {_slot} to loop-number
            stop loop

    if {_slot} = 0:
        give cod to {_p}
        stop

    add 1 to {-fishbarrel::count::%{_uuid}%}
    fishbarrel_flyAndPlace({_p}, {_hookLoc}, {_slot}, cod)


# ============================================================
# CLEAR A PLAYER'S FISH
# ============================================================

function fishbarrel_clearPlayer(p: player):
    set {_uuid} to uuid of {_p}
    set {_max} to fishbarrel_maxFish({_p})
    loop {_max} times:
        fishbarrel_removeSlot({_p}, loop-number)
    set {-fishbarrel::count::%{_uuid}%} to 0


# ============================================================
# FISHING EVENTS
# ============================================================

on PlayerFishEvent:
    if event.getState() != State.FISHING:
        stop
    set {_hook} to event.getHook()
    if {_hook} is not set:
        stop
    {_hook}.setMinWaitTime(1)
    {_hook}.setMaxWaitTime(1)
    {_hook}.setApplyLure(false)


on PlayerFishEvent:
    if event.getState() != State.CAUGHT_FISH:
        stop
    if event.getCaught() is set:
        event.getCaught().remove()
    event.setExpToDrop(0)


on PlayerFishEvent:
    if event.getState() != State.BITE:
        stop
    set {_hook} to event.getHook()
    if {_hook} is not set:
        stop
    set {_p} to event.getPlayer()
    fishbarrel_addFish({_p}, {_hook}.getLocation())


on join:
    wait 5 ticks
    set {_max} to fishbarrel_maxFish(player)
    loop {_max} times:
        fishbarrel_spawnSlotFor(player, loop-number)
    fishbarrel_spawnComposterFor(player)


# ============================================================
# COMMANDS
# ============================================================

command /fishbarrel [<text>] [<text>] [<text>]:
    trigger:
        if arg-1 is not set:
            send "" to player
            send "&b&lFish Barrel" to player
            send "&7/fishbarrel set &8— &7(Admin) Aim at a composter to register it" to player
            send "&7/fishbarrel level <player> <1-5> &8— &7(Admin) Set a player's barrel level" to player
            send "&7/fishbarrel clear <player> &8— &7(Admin) Empty a player's barrel" to player
            send "" to player
            stop

        # ── SET ──────────────────────────────────────────────
        if arg-1 = "set":
            if player does not have permission "op":
                send "&cYou don't have permission to do that." to player
                stop
            set {_tb} to target block of player
            if {_tb} is not set:
                send "&cLook at a composter block first!" to player
                stop
            if type of {_tb} is not composter:
                send "&cThat block is not a composter!" to player
                stop
            # Remove every online player's old composter display then re-spawn
            loop all players:
                fishbarrel_removeComposter(loop-player)
            set {-fishbarrel::loc} to location of {_tb}
            loop all players:
                fishbarrel_spawnComposterFor(loop-player)
            send "&aFish barrel registered at &e%{-fishbarrel::loc}%&a!" to player
            stop

        # ── LEVEL ────────────────────────────────────────────
        else if arg-1 = "level":
            if player does not have permission "op":
                send "&cYou don't have permission to do that." to player
                stop
            if arg-2 is not set:
                send "&cUsage: &e/fishbarrel level <player> <1-5>" to player
                stop
            if arg-3 is not set:
                send "&cUsage: &e/fishbarrel level <player> <1-5>" to player
                stop
            set {_target} to arg-2 parsed as player
            if {_target} is not set:
                send "&cPlayer '&e%arg-2%&c' is not online." to player
                stop
            set {_lvl} to arg-3 parsed as integer
            if {_lvl} is not set:
                send "&cInvalid level. Enter a number between 1 and 5." to player
                stop
            if {_lvl} < 1:
                send "&cLevel must be between &e1 &cand &e5&c." to player
                stop
            if {_lvl} > 5:
                send "&cLevel must be between &e1 &cand &e5&c." to player
                stop
            set {-fishbarrel::level::%uuid of {_target}%} to {_lvl}
            fishbarrel_updateComposter({_target})
            fishbarrel_reorganize({_target})
            set {_max} to fishbarrel_maxFish({_target})
            set {_scale} to fishbarrel_levelScale({_target})
            send "&aSet &e%name of {_target}%&a's barrel to &elevel %{_lvl}% &7(x%{_scale}% size, max &f%{_max}% &7fish)." to player
            send "&7Your barrel was upgraded to &elevel %{_lvl}% &7by an admin." to {_target}
            stop

        # ── CLEAR ────────────────────────────────────────────
        else if arg-1 = "clear":
            if player does not have permission "op":
                send "&cYou don't have permission to do that." to player
                stop
            if arg-2 is not set:
                send "&cUsage: &e/fishbarrel clear <player>" to player
                stop
            set {_target} to arg-2 parsed as player
            if {_target} is not set:
                send "&cPlayer '&e%arg-2%&c' is not online." to player
                stop
            set {_count} to ({-fishbarrel::count::%uuid of {_target}%} ? 0)
            if {_count} = 0:
                send "&7%name of {_target}%'s barrel is already empty." to player
                stop
            fishbarrel_clearPlayer({_target})
            send "&aCleared &e%name of {_target}%&a's barrel. &7Removed &f%{_count}% &7fish." to player
            stop

        # ── UNKNOWN ──────────────────────────────────────────
        else:
            send "&cUnknown subcommand. Use &e/fishbarrel &cfor help." to player
